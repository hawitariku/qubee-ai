# Qubeessaa AI — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# ── Server ────────────────────────────────────────────────────────────────
# Port the app listens on. Railway/Render inject this automatically.
# Only set manually for local development.
PORT=8080

# ── Redis (optional) ──────────────────────────────────────────────────────
# When set, the app uses Redis for distributed rate limiting (100 req/min/IP).
# Without it the app falls back to in-memory rate limiting automatically.
# Get this from your Redis provider (Railway Redis plugin, Render Redis, etc.)
REDIS_URL=redis://localhost:6379

# ── ML Model (optional) ───────────────────────────────────────────────────
# Set to "false" to skip loading the AfriBERTa transformer model on startup.
# This makes the app start in ~6 s instead of ~2 min and uses no GPU memory.
# The statistical spell checker is fully functional without the ML model.
# Default: true (model loads if transformers + torch are installed)
# USE_ML=false
